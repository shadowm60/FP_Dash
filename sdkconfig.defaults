# This file was generated using idf.py save-defconfig. It can be edited manually.
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_LINE_SIZE=64
# Larger caches: LVGL renders into PSRAM frame buffers (Espressif RGB LCD recommendation)
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# GPIO19/20 (native USB) become the CAN bus once EXIO5 is switched, so the
# console must be on UART0 = the board's "UART" USB-C port (CH343).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# BSW Display Configuration
CONFIG_BSW_LVGL_PORT_TASK_CORE=1
CONFIG_BSW_LVGL_PORT_AVOID_TEAR_ENABLE=y
CONFIG_BSW_LVGL_PORT_AVOID_TEAR_MODE_3=y

# BSW Hardware Peripheral Pins (Waveshare ESP32-S3-Touch-LCD-7)
CONFIG_CAN_TX=20
CONFIG_CAN_RX=19
CONFIG_I2C_MASTER_SCL=9
CONFIG_I2C_MASTER_SDA=8
CONFIG_SDCARD_PIN_MOSI=11
CONFIG_SDCARD_PIN_MISO=13
CONFIG_SDCARD_PIN_CLK=12
CONFIG_SDCARD_PIN_CS=-1

CONFIG_LV_COLOR_SCREEN_TRANSP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_PERF_MONITOR=y
# < one panel frame (~25.6 ms at 16 MHz pclk) so every vsync can be used
CONFIG_LV_DISP_DEF_REFR_PERIOD=15
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_IMGFONT=y
# CONFIG_LV_USE_DEMO_WIDGETS is not set
# CONFIG_LV_USE_DEMO_BENCHMARK is not set
# CONFIG_LV_USE_DEMO_STRESS is not set
# CONFIG_LV_USE_DEMO_MUSIC is not set
CONFIG_TWAI_SUPPRESS_DEPRECATE_WARN=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
